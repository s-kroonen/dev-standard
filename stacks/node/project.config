INSTALL_CMD="npm ci"
FORMAT_CMD="npx prettier --check ."
LINT_CMD="npm run lint --if-present --workspaces --include-workspace-root -- --max-warnings=0"
TYPECHECK_CMD="npx tsc --noEmit"
TEST_CMD="npm test --if-present --workspaces --include-workspace-root -- --ci"
BUILD_CMD="npm run build --if-present --workspaces --include-workspace-root"
OPENGREP_OPEN_RULESETS="typescript javascript dockerfile generic/secrets yaml/github-actions"
OPENGREP_RULES=".opengrep/rules/custom .opengrep/rules/open"
# Reviewed noise (style rules that hide real findings). Use the exact id the scan prints
# (path prefix included), e.g. from: scripts/check sast
#   react-props-spreading: standard shadcn/ui pattern; jsx-not-internationalized: i18n, not security
OPENGREP_EXCLUDE_RULES="opengrep.rules.open.typescript.react.best-practice.react-props-spreading opengrep.rules.open.typescript.react.portability.i18next.jsx-not-internationalized"
