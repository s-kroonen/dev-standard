INSTALL_CMD="pip install -e '.[dev]'"
FORMAT_CMD="ruff format --check ."
LINT_CMD="ruff check ."
TYPECHECK_CMD="mypy src"
TEST_CMD="pytest -q"
BUILD_CMD="python -m build --wheel --outdir dist/"
OPENGREP_OPEN_RULESETS="python dockerfile generic/secrets yaml/github-actions"
OPENGREP_RULES=".opengrep/rules/custom .opengrep/rules/open"
OPENGREP_EXCLUDE_RULES=""
