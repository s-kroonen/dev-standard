# check.config — project settings for scripts/check, scripts/setup and CI ({{ project_name }}). Sourced by bash.
# A guardrail file (.guardrails): agents don't change it; humans change it through a reviewed PR.

# >>> project (stack layer: copier question "stack"; change with `copier update --data stack=<name>`)
# Empty = not configured (skip locally, FAIL in CI). "none" = not applicable.
# Every stack must define TEST_LIST_CMD (zero tests = failure), SKIP_MARKERS and ASSERT_PATTERN
# (test integrity) and COVERAGE_CMD; tests/quality-canary/ proves the gates fail on planted cases.
{%- if stack == 'none' %}
# Day 0: no stack decided (docs/decisions/0002-choose-the-stack.md). Source files fail
# `check fast` (code-needs-gates) until a stack is set; experiments go to spikes/ on a spike/* branch.
INSTALL_CMD="none"
FORMAT_CMD="none"
FORMAT_FILE_CMD="none"
LINT_FILE_CMD="none"
LINT_CMD="none"
TYPECHECK_CMD="none"
TEST_CMD="none"
TEST_LIST_CMD=""
BUILD_CMD="none"
COVERAGE_CMD="none"
OPENGREP_OPEN_RULESETS="dockerfile generic/secrets yaml/github-actions"
{%- elif stack == 'python' %}
# Python with uv (lockfile uv.lock); ruff, mypy, pytest (+pytest-cov) as dev dependencies.
# The canary folders hold planted problems: the gates skip them (inside a case the paths don't match).
INSTALL_CMD="uv sync --frozen"
RUFF_EXCLUDE="--config 'extend-exclude=[\"tests/quality-canary\", \"tests/security-canary\", \"spikes\", \".specify\"]'"
FORMAT_CMD="uv run ruff format --check $RUFF_EXCLUDE ."
FORMAT_FILE_CMD="uv run ruff format {file}"   # after each edit by the agent (.claude/hooks/format-file.sh)
LINT_FILE_CMD="uv run ruff check {file}"   # after each edit by the agent (.claude/hooks/lint-file.sh)
LINT_CMD="uv run ruff check $RUFF_EXCLUDE ."
TYPECHECK_CMD="uv run mypy --exclude '^(tests/(quality|security)-canary|spikes|\.specify)/' ."
PYTEST_IGNORE="--ignore=tests/quality-canary --ignore=tests/security-canary --ignore=spikes"
TEST_CMD="uv run pytest -q $PYTEST_IGNORE"
TEST_LIST_CMD="uv run pytest --collect-only -q $PYTEST_IGNORE 2>/dev/null | grep '::'"
SKIP_MARKERS='@pytest\.mark\.(skip|skipif|xfail)|pytest\.skip\(|unittest\.skip'
ASSERT_PATTERN='(^|[^a-z_])assert[ (]|pytest\.raises|self\.assert'
BUILD_CMD="uv build --quiet"
COVERAGE_CMD="uv run pytest -q $PYTEST_IGNORE --cov --cov-report=xml:coverage.xml"
COVERAGE_FILE="coverage.xml"
SAFETY_TEST_CMD="uv run pytest -q $PYTEST_IGNORE -m safety"
SAFETY_TEST_LIST_CMD="uv run pytest --collect-only -q $PYTEST_IGNORE -m safety 2>/dev/null | grep '::'"
OPENGREP_OPEN_RULESETS="python dockerfile generic/secrets yaml/github-actions"
{%- elif stack == 'node' %}
# Node / TypeScript with npm: prettier, eslint + typescript-eslint, tsc, vitest (+ @vitest/coverage-v8).
# Tested 2026-11-24. The canary folders are excluded here and in .prettierignore; keep tsconfig
# "include" on your source folders (not ".").
INSTALL_CMD="npm ci --ignore-scripts"
FORMAT_CMD="npx prettier --check ."
FORMAT_FILE_CMD="npx prettier --write {file}"
LINT_FILE_CMD="npx eslint --max-warnings=0 {file}"
LINT_CMD="npx eslint --max-warnings=0 --ignore-pattern 'tests/*-canary/**' --ignore-pattern 'spikes/**' --ignore-pattern '.specify/**' --ignore-pattern 'coverage/**' --ignore-pattern 'dist/**' ."
TYPECHECK_CMD="npx tsc --noEmit"
VITEST_EXCLUDE="--exclude 'tests/*-canary/**' --exclude 'spikes/**'"
TEST_CMD="npx vitest run $VITEST_EXCLUDE"
TEST_LIST_CMD="npx vitest list $VITEST_EXCLUDE 2>/dev/null"
SKIP_MARKERS='\.(skip|only|todo)\(|(^|[^A-Za-z])x(it|describe|test)\('
ASSERT_PATTERN='expect\(|assert[.(]'
BUILD_CMD="npm run build"
COVERAGE_CMD="npx vitest run $VITEST_EXCLUDE --coverage --coverage.reporter=lcov"
COVERAGE_FILE="coverage/lcov.info"
SAFETY_TEST_CMD="npx vitest run $VITEST_EXCLUDE -t safety"
SAFETY_TEST_LIST_CMD="npx vitest list $VITEST_EXCLUDE -t safety 2>/dev/null"
OPENGREP_OPEN_RULESETS="typescript javascript dockerfile generic/secrets yaml/github-actions"
OPENGREP_EXCLUDE_RULES="opengrep.rules.open.typescript.react.best-practice.react-props-spreading opengrep.rules.open.typescript.react.portability.i18next.jsx-not-internationalized"
{%- elif stack == 'rust' %}
# Rust with cargo. Tested 2026-11-24 (fmt, clippy, test, test count, ignore marker).
INSTALL_CMD="cargo fetch --locked"
FORMAT_CMD="cargo fmt --all -- --check"
FORMAT_FILE_CMD="rustfmt --edition 2021 {file}"   # keep the edition of Cargo.toml
LINT_FILE_CMD="none"   # clippy works on the whole crate: the Stop hook runs it
LINT_CMD="cargo clippy --all-targets --all-features --locked -- -D warnings"
TYPECHECK_CMD="none"   # the compiler is the type checker (clippy builds)
TEST_CMD="cargo test --all-targets --locked"
TEST_LIST_CMD="cargo test --all-targets --locked -- --list --format=terse 2>/dev/null | grep ': test$'"
SKIP_MARKERS='#\[ignore'
ASSERT_PATTERN='assert(_eq|_ne)?!|panic!|should_panic'
BUILD_CMD="cargo build --release --locked"
COVERAGE_CMD="cargo llvm-cov --all-targets --lcov --output-path lcov.info"   # needs cargo-llvm-cov
COVERAGE_FILE="lcov.info"
SAFETY_TEST_CMD="cargo test --all-targets --locked safety"
SAFETY_TEST_LIST_CMD="cargo test --all-targets --locked -- --list --format=terse safety 2>/dev/null | grep ': test$'"
OPENGREP_OPEN_RULESETS="rust dockerfile generic/secrets yaml/github-actions"
{%- elif stack == 'dotnet' %}
# C# / .NET. UNVERIFIED (no .NET SDK in the test environment, STD-24): check zero-test behaviour,
# test listing and coverage paths before relying on it. Directory.Build.props must set
# TreatWarningsAsErrors, Nullable, AnalysisMode, NuGetAudit and RestorePackagesWithLockFile.
INSTALL_CMD="dotnet restore --locked-mode"
FORMAT_CMD="dotnet format --verify-no-changes"
FORMAT_FILE_CMD="dotnet format --include {file}"   # UNVERIFIED
LINT_FILE_CMD="none"   # the build lints the whole project: the Stop hook runs it
LINT_CMD="dotnet build --no-restore -warnaserror"
TYPECHECK_CMD="none"   # the compiler is the type checker
TEST_CMD="dotnet test --no-restore"
TEST_LIST_CMD="dotnet test --no-restore --list-tests 2>/dev/null | sed -n '/The following Tests are available:/,\$p' | tail -n +2"
SKIP_MARKERS='Skip *=|\[Ignore'
ASSERT_PATTERN='Assert\.|\.Should\(\)'
BUILD_CMD="dotnet publish -c Release --no-restore"
COVERAGE_CMD="dotnet test --no-restore --collect:'XPlat Code Coverage' --results-directory .coverage && cp .coverage/*/coverage.cobertura.xml coverage.xml"
COVERAGE_FILE="coverage.xml"
SAFETY_TEST_CMD="dotnet test --no-restore --filter Category=Safety"
SAFETY_TEST_LIST_CMD="dotnet test --no-restore --list-tests --filter Category=Safety 2>/dev/null | sed -n '/The following Tests are available:/,\$p' | tail -n +2"
OPENGREP_OPEN_RULESETS="csharp dockerfile generic/secrets yaml/github-actions"
{%- elif stack == 'flutter' %}
# Flutter / Dart. Partly unverified (test listing); no SAST rules exist for Dart.
INSTALL_CMD="flutter pub get --enforce-lockfile"
FORMAT_CMD="dart format --output=none --set-exit-if-changed lib test"
FORMAT_FILE_CMD="dart format {file}"
LINT_FILE_CMD="none"   # flutter analyze works on the whole project: the Stop hook runs it
LINT_CMD="flutter analyze --fatal-infos"
TYPECHECK_CMD="none"   # flutter analyze covers it
TEST_CMD="flutter test"
TEST_LIST_CMD="flutter test --reporter json 2>/dev/null | grep '\"type\":\"testStart\"' | grep -v 'loading '"
SKIP_MARKERS='skip: *(true|["'\''])'
ASSERT_PATTERN='expect\('
BUILD_CMD="flutter build web --release"
COVERAGE_CMD="flutter test --coverage"
COVERAGE_FILE="coverage/lcov.info"
SAFETY_TEST_CMD="flutter test --tags safety"
SAFETY_TEST_LIST_CMD="flutter test --tags safety --reporter json 2>/dev/null | grep '\"type\":\"testStart\"' | grep -v 'loading '"
OPENGREP_OPEN_RULESETS="dockerfile generic/secrets yaml/github-actions"
{%- endif %}
OPENGREP_RULES=".opengrep/rules/custom .opengrep/rules/open"
{%- if stack != 'node' %}
OPENGREP_EXCLUDE_RULES=""
{%- endif %}
COVERAGE_CHANGED_MIN=80   # % of changed lines covered by tests
COVERAGE_TOTAL_MIN=0      # raise it to the current total once code exists (playbook step 12); never lower it
SAFETY_REQUIRED={{ 'true' if safety_critical else 'false' }}   # constitution VII: safety-tagged tests must exist and pass
QUALITY_CANARY_DIR="tests/quality-canary/{{ stack }}"
# <<< project

# >>> stack layer playbook (docs/process/stack-layer.md; skill /stack-layer)
# After the stack decision and again as the code grows, each variable is decided: a command, or
# "none" with a reason comment on the same line, e.g.  E2E_CMD="none"   # no UI.
# Empty = undecided: `scripts/check stack-layer` warns locally and FAILS in CI once code exists.
# architecture boundaries (import-linter, dependency-cruiser, cargo-modules, NetArchTest, ...)
ARCH_CMD=""
# complexity and duplication (ruff C90, eslint complexity + jscpd, clippy, CA1502, ...)
COMPLEXITY_CMD=""
# performance budgets from the quality attributes (pytest-benchmark, vitest bench, criterion, ...)
PERF_CMD=""
# UI: Playwright incl. accessibility (axe) and a bundle-size budget
E2E_CMD=""
# contracts between parts: OpenAPI / AsyncAPI diff + schema-based tests
CONTRACT_CMD=""
# the language's own security tools (pip-audit, npm audit signatures, cargo-deny, ...)
SECURITY_NATIVE_CMD=""
# fuzz parsers of untrusted input; use ${FUZZ_SECONDS:-30} (CI sets 600 in the weekly run)
FUZZ_CMD=""
# scan of the running app (ZAP baseline), when it serves HTTP
DAST_CMD=""
# <<< stack layer playbook

# --- Rules -----------------------------------------------------------------------------------------
ISSUE_KEY="{{ issue_key }}"
{%- set agentic = [] %}
{%- if feature_level == 'agentic' %}{% set _ = agentic.append('feat') %}{% endif %}
{%- if bug_level == 'agentic' %}{% set _ = agentic.append('fix') %}{% endif %}
{%- if release_level == 'agentic' %}{% set _ = agentic.append('release') %}{% endif %}
AGENT_BRANCH_RE='^({{ (agentic + ['claude']) | join('|') }})/|^ccr-'   # agent branches (same as .claude/hooks/git-policy.sh)
COMMIT_TYPES="feat|fix|docs|refactor|perf|test|build|ci|chore|revert"
COMMIT_KEY_REQUIRED="feat|fix"                # these types must carry the issue key as scope
PR_MAX_LINES=800                              # agentic PRs (bugs, releases) are checked against this
FIX_MAX_LINES=200                             # fix/ branches: more is not a small fix (escalate to a person)
# A fix/ branch that touches these needs a person's review: label large-change (security, data, safety).
SENSITIVE_PATHS='(^|/)(auth|security|crypto|safety|migrations?)(/|[._-])|(^|/)\.env'
LICENSE_SEVERITY="HIGH,CRITICAL"              # trivy licence classes that block: forbidden = CRITICAL, restricted = HIGH
RESEARCH_MAX_AGE_DAYS=90                      # research findings are re-checked within this time (docs/research/README.md)
RESEARCH_EXEMPT_ADRS="0001"                   # decision numbers that need no research evidence
STOP_STAGES="fast test build"                 # what the agent's Stop hook runs (.claude/hooks/run-checks.sh)
# Vale (writing rule, docs/process/writing.md): a path regex for content in another language or vendored
# text that the prose rules skip. Markdown and source comments are linted otherwise; see .vale.ini.
VALE_EXCLUDE=""
# AI watermarks (ERE, case-insensitive) that fail commit messages, PR titles and PR bodies.
WATERMARK_PATTERN='^[[:space:]]*Co-Authored-By:.*(Claude|Anthropic|Copilot|ChatGPT|OpenAI|Gemini|Codex|Cursor|Aider|Devin)|^[[:space:]]*Claude-Session:|Generated (with|by) \[?(Claude|Copilot|ChatGPT|Codex|Cursor|Gemini)|🤖|claude\.ai/(code|chat)/[^[:space:]]*session'
SECURITY_SEVERITY="HIGH,CRITICAL"             # what blocks: deps gate, config, image
CANARY_DIR="tests/security-canary"
TODO_FILE="TODO.md"
DEP_DOCS="specs/*/plan.md docs/decisions/*.md"   # a new dependency must be named in one of these
SKIP_DIRS="node_modules,.dart_tool,build,dist,.venv,.tools,target,bin,obj"

