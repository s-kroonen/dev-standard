# Toolchain and dependencies for scripts/check, for the stack in .copier-answers.yml ({{ stack }}).
# Actions are pinned to a commit SHA (version in the comment); Dependabot proposes updates.
name: setup
description: Toolchain and dependencies for scripts/check
runs:
  using: composite
  steps:
{%- if stack == 'none' %}
    - shell: bash
      run: echo "Day 0 - no stack yet; nothing to install."
{%- elif stack == 'python' %}
    - uses: astral-sh/setup-uv@1db35dd8eee11c5894872e0b383ae6c406cf738d # v10.4.0
      with:
        enable-cache: true
    - shell: bash
      run: uv sync --frozen
{%- elif stack == 'node' %}
    - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
      with:
        node-version-file: .nvmrc
        cache: npm
    - shell: bash
      run: npm ci --ignore-scripts
{%- elif stack == 'rust' %}
    - shell: bash
      run: |
        rustup show active-toolchain || rustup default stable
        rustup component add clippy rustfmt llvm-tools-preview
        command -v cargo-llvm-cov >/dev/null || cargo install cargo-llvm-cov --locked
        cargo fetch --locked
{%- elif stack == 'dotnet' %}
    - uses: actions/setup-dotnet@0f4a354dd5547a28c70b7853dbd95d5b67886e73 # v6.1.0
      with:
        global-json-file: global.json
    - shell: bash
      run: dotnet restore --locked-mode
{%- elif stack == 'flutter' %}
    - uses: subosito/flutter-action@1a449444c387b1966244ae4d4f8c696479add0b2 # v2.23.0
      with:
        flutter-version-file: pubspec.yaml
        cache: true
    - shell: bash
      run: flutter pub get --enforce-lockfile
{%- endif %}
