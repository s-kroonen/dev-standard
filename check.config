# check.config of dev-standard: the checks of the standard applied to this repository (AGENTS.md).
# A guardrail file (.guardrails): agents do not change it; a person changes it through a reviewed PR.
# Sourced by scripts/check (template/scripts/check) and scripts/install-tools.

# Pinned tools: one source, template/check.config.jinja (plain assignments with a trailing comment).
eval "$(grep -E '^(GITLEAKS|TRIVY|OSV|OPENGREP|LEFTHOOK|VALE)_(VERSION|SHA256)=|^MARKDOWNLINT_VERSION=' template/check.config.jinja | sed 's/[[:space:]]*#.*//')"
GITLEAKS_IMAGE="ghcr.io/gitleaks/gitleaks:v${GITLEAKS_VERSION}"
# shellcheck: not part of the template; release page checksum of the linux.x86_64 tarball.
SHELLCHECK_VERSION="0.11.0"                                                            # released 2025-08-03
SHELLCHECK_SHA256="8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198"   # shellcheck-v0.11.0.linux.x86_64.tar.xz; the release publishes no checksum file

# --- Rules (work types of AGENTS.md: features ai-assist; fixes and releases agentic) ----------------
ISSUE_KEY="STD"
AGENT_BRANCH_RE='^(fix|release|claude)/|^ccr-'
COMMIT_TYPES="feat|fix|docs|refactor|perf|test|build|ci|chore|revert"
COMMIT_KEY_REQUIRED="feat|fix"
PR_MAX_LINES=800
FIX_MAX_LINES=200
SENSITIVE_PATHS='(^|/)\.github/|(^|/)\.claude/|^scripts/|^check\.config$|^\.guardrails$'
TODO_FILE="TODO.md"
STOP_STAGES="fast docs"
DEP_DOCS=""

# --- Gates (no product code: shell, YAML and Markdown) ----------------------------------------------
INSTALL_CMD="none"
FORMAT_CMD="none"
FORMAT_FILE_CMD="none"
LINT_FILE_CMD="none"
LINT_CMD="scripts/lint"
TYPECHECK_CMD="none"
TEST_CMD="none"
BUILD_CMD="none"
COVERAGE_CMD="none"
# The canary code under stacks/ and template/ is product content of the standard, not source of this repository.
NON_CODE_PATHS='^(template|stacks|speckit-preset|tests|scripts)/|^\.(claude|github)/'

# --- The writing rule (docs/process/writing.md): the styles come from the template ------------------
VALE_SKIP='^(\.git|\.specify|\.opengrep|\.tools|node_modules|spikes|specs)/|(^|/)node_modules/|^template/tests/|^template/\.vale/|^stacks/[a-z]+/(canary|rules)/|^docs/handover/'
VALE_EXCLUDE=""
